# ===================================================================
# MODULE 1 — Feed Observer (Manual Worker · Gemini Web mode)
# ===================================================================
# 1 Navigate FB → 2 Screenshot post → 3 Gemini WEB best comment → 4 React+comment → 5 Human delays
FB_HOME_URL=https://www.facebook.com
# web (default) | api | both
GEMINI_MODE=web
GEMINI_WEB_URL=https://gemini.google.com/app
# Optional: ask Gemini for JSON {reaction, comment} instead of plain comment
GEMINI_STRUCTURED_JSON=true
GEMINI_RESPONSE_WAIT_MS=60000
# Runtime-customizable settings live in data/module1_settings.json (PUT /api/v1/module1/config).
# Defaults (overridable by that file):
#   feed_url, max_posts_per_run, gap_between_posts_min/max, scroll_delta_min/max,
#   reading_dwell_min/max, long_break_every/min/max, humanization_enabled,
#   typing_style (paste|type), typo_probability, key_delay_min_ms/max_ms,
#   reaction_mode (auto|fixed|none), fixed_reaction, comment_enabled, min_confidence,
#   work_hours_start/end (HH:MM), max_actions_per_hour/day,
#   gemini_login_wait_sec, gemini_reply_wait_sec, fresh_chat_per_post, structured_reply,
#   comment_style (casual|friendly|professional|promotional|custom), custom_prompt,
#   pause_on_checkpoint, checkpoint_wait_sec, skip_already_commented, max_seen_posts.
GEMINI_LOGIN_WAIT_MS=600000
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.0-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MOD1_AI_BASE_URL=
MOD1_AI_API_KEY=
MOD1_AI_MODEL=gemini-2.0-flash
FB_USER_DATA_DIR=
FB_HEADLESS=false
FB_LOGIN_WAIT_MS=120000
M1_DEFAULT_REACTION=LIKE
# false = human typing; true = clipboard paste into comment box
M1_COMMENT_PASTE=false
M1_MIN_CONFIDENCE=0.55
M1_LIVE=false
M1_SUITE_POSTS=1

# ===================================================================
# ON-SCREEN VISUAL RUNNER (Control Center → Run module)
# ===================================================================
# true = every module opens a Chromium window showing live steps
SUITE_VISUAL=true
SUITE_HEADLESS=false
SUITE_VISUAL_HOLD_MS=4500
# Web Control Center always streams steps at / (Live Preview panel)

# ===================================================================
# MODULE 3 — Lead Funnel & Ad Guard
# ===================================================================
M3_DRY_RUN=true
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v19.0
M3_LEAD_LINK=https://example.com/offer
M3_ROAS_TARGET=2.5
M3_BUDGET_SCALE_PCT=15

# ===================================================================
# HUMANIZATION (run like a human)
# ===================================================================
# Profiles: natural | cautious | active
HUMANIZATION_ENABLED=true
HUMAN_PROFILE=natural
# Use shortened group-share delays in local demos (false = real 45–120s)
HUMAN_SIMULATE_FAST=true
# Warm-up start date (ISO). Day 0 starts at 15% of daily action cap.
ACCOUNT_WARMUP_START=2026-08-06

# ===================================================================
# GLOBAL MASTER AI GATEWAY SETTINGS (LEVEL 1)
# ===================================================================
MASTER_AI_BASE_URL=https://api.openai.com/v1
MASTER_AI_API_KEY=sk-proj-your-master-api-key
MASTER_AI_MODEL=gpt-4o

# ===================================================================
# PER-MODULE OVERRIDES (LEVEL 2)
# ===================================================================
# Module 2 (DOM & Vision) - Local Ollama / Vision Overrides
MOD2_AI_BASE_URL=http://localhost:11434/v1
MOD2_AI_API_KEY=ollama
MOD2_AI_MODEL=qwen2.5-vl

# Module 3 (DM Copywriting) - Groq / Fast Model Overrides
MOD3_AI_BASE_URL=https://api.groq.com/openai/v1
MOD3_AI_API_KEY=gsk_your_groq_key
MOD3_AI_MODEL=llama-3.3-70b-versatile

# Module 8 (Agent Orchestrator) - DeepSeek / Reasoning Overrides
MOD8_AI_BASE_URL=https://api.deepseek.com/v1
MOD8_AI_API_KEY=sk-your-deepseek-key
MOD8_AI_MODEL=deepseek-reasoner

# ===================================================================
# DATABASE & CACHE STACK
# ===================================================================
POSTGRES_USER=wolf_admin
POSTGRES_PASSWORD=wolf_secure_pass_2026
POSTGRES_DB=wolf_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wolf_admin:wolf_secure_pass_2026@localhost:5432/wolf_db

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
# Force in-memory Redis shim (no Docker required)
REDIS_FORCE_MEMORY=false
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
M4_FLAKY_DISPATCH=false

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_pass

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_FORCE_MEMORY=false

# ===================================================================
# MODULE 2 — Media Engine
# ===================================================================
M2_DRY_RUN=true
M2_PUBLIC_MEDIA_URL=
M2_MAX_IMAGE_BYTES=8388608
IG_USER_ID=
THREADS_USER_ID=

# ===================================================================
# MODULE 7 — Webhooks
# ===================================================================
M7_SIMULATE=false
M7_FORCE_HTTP=false
M7_AUTH_REQUIRED=false

# ===================================================================
# SAML / SCIM
# ===================================================================
SAML_SP_ENTITY_ID=https://auth.enterprise.domain
BOXYHQ_JACKSON_URL=
BOXYHQ_JACKSON_API_KEY=
SCIM_DB_PATH=

# ===================================================================
# META / FACEBOOK INTEGRATION
# ===================================================================
META_PAGE_ACCESS_TOKEN=EAAG...
META_PAGE_ID=123456789
META_APP_SECRET=your_app_secret
META_VERIFY_TOKEN=your_webhook_verify_token

# ===================================================================
# ENTERPRISE SECURITY & ENCRYPTION
# ===================================================================
KMS_MASTER_KEY=32_byte_hex_key_for_aes_256_gcm_envelope_encryption
JWT_SECRET=your_jwt_signing_secret_key_change_in_production
WEBHOOK_HMAC_SECRET=whsec_your_webhook_hmac_secret_key
